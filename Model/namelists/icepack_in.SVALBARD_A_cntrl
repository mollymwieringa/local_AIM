&setup_nml
    days_per_year  = 365           ! # of days in one year
    use_leap_years = .true.        ! if true, include leap days
    year_init      = 2024          ! the initial year
    istep0         = 2184          ! number of steps taken in a previous run
    dt             = 3600.0        ! thermodynamics timestep (seconds)
    npt            = 9600          ! total number of timesteps (to run)
    ndtd           = 1             ! number of dynamics/advections steps under thermo
    ice_ic         = '/Users/mollyw/Desktop/ARISE-AIM/Model/restarts/Svalbard_A_iced.2024-04-01-00000.nc'        ! choice of initial conditions
    hi_init_slab   = 0.7
    hsno_init_slab = 0.1
    hbar_init_itd  = 0.7
    hsno_init_itd  = 0.1
    sst_init       = -1.8          ! initial mixed layer temperature
    restart        = .true.       ! if true, initialize from restart
    restart_dir    = './restart/'  ! path to restart files
    restart_format = 'nc'          ! format of restart files
    dumpfreq       = 'd'           ! frequency of restart dumps
    dump_last      = .false.       ! ?
    diagfreq       = 24            ! how often diagnostic output is written
    diag_file      = 'ice_diag'    ! diagnostic output file name
    history_format = 'nc'          ! writes history output as netcdf if set to 'nc'
    cpl_bgc        = .false.
    conserv_check  = .false.       ! if true, check conservation
    itd_area_min   = 1.e-11
    itd_mass_min   = 1.e-10
/

&grid_nml
    kcatbound    = 1                ! category boundary formula
/

&tracer_nml
    tr_iage      = .true.           ! use ice age tracer
    tr_FY        = .true.           ! use first-year ice tracer
    tr_lvl       = .true.           ! use level ice area and volume tracers
    tr_pond_topo = .false.          ! use topo melt pond scheme
    tr_pond_lvl  = .false.          ! use level-ice melt pond scheme
    tr_pond_sealvl = .true.         ! use sea level melt pond scheme
    tr_snow      = .true.           ! use snow area and volume tracers
    tr_aero      = .false.          ! use aerosol tracers
    tr_fsd       = .false.          ! use floe size distribution tracer
    tr_iso       = .false.          ! use water isotope tracers
/

&thermo_nml
    kitd              = 0           ! itd remapping scheme 
    ktherm            = 2           ! thermodynamics scheme (mushy = 2)
    hi_min            = 0.01        ! minimum ice thickness (m) for thinnest ice cat.
    ksno              = 0.3d0       ! snow thermal conductivity (W/m/K)
    conduct           = 'bubbly'    ! conductivity parameterization
    a_rapid_mode      =  1.0e-3     ! brine channel diameter
    Rac_rapid_mode    =    10.0     ! critical Rayleigh number
    aspect_rapid_mode =     1.0     ! brine convection aspect ratio
    dSdt_slow_mode    = -1.5e-7     ! drainage strength parameter
    phi_c_slow_mode   =    0.05     ! critical liquid fraction
    phi_i_mushy       =    0.45     ! solid fraction at lower boundary
    Tliquidus_max     =   0.0d0     ! maximum liquidus temperature of mush (C)
    floediam          = 300.0d0     ! effective floe diameter for lateral melt (m)
    hfrazilmin        =  0.05d0     ! minimum thickness of new frazil ice (m)
    tscale_pnd_drain  =   0.5d0
    landfast          = .true.
/

&shortwave_nml
