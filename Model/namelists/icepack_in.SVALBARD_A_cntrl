    lateral_flux_type   = 'uniform_ice' ! how to address ice closures / replacement 
    fyear_init      = 2024          ! initial forcing year
    ycycle          = 2             ! number of years in forcing data cycle
    data_dir        = '/Users/mollyw/Desktop/ARISE-AIM/Model/forcing'
    atm_data_file   = 'Svalbard_atm_MDF.nc'
    ocn_data_file   = 'unknown_ocn_data_file'
    bgc_data_file   = 'unknown_bgc_data_file'
